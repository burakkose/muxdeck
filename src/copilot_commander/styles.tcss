/* ── Modern Dark — copilot-commander ─────────────────────────────── */

Screen {
    background: #151921;
    color: #e2e8f0;
}

/* ── shell chrome ────────────────────────────────────────────────── */

#shell-tab-bar {
    dock: top;
    height: 1;
    background: #0d1017;
    color: #e2e8f0;
}

#shell-frame {
    height: 1fr;
    layout: vertical;
    background: #151921;
    padding: 0 0;
}

#shell-footer {
    dock: bottom;
    height: 1;
    background: #0d1017;
}

/* ── shared frame: one rounded box per screen ────────────────────── */

.frame {
    border: round #272c36;
    border-title-color: #94a3b8;
    border-title-style: bold;
    background: #151921;
}

.frame:focus-within {
    border: round #3b82f6;
}

/* ── panel sections inside frames (borderless, thin separators) ─── */

.section {
    border: none;
    background: #151921;
    padding: 0 1;
}

.section-top {
    border: none;
    border-top: solid #272c36;
    background: #151921;
    padding: 0 1;
}

.divider-right {
    border: none;
    border-right: solid #272c36;
    padding: 0 1;
}

/* legacy .panel for screens not yet fully migrated */
.panel {
    border: round #272c36;
    background: #151921;
    padding: 0 1;
    border-title-color: #94a3b8;
    border-title-style: bold;
}

.panel:focus-within {
    border: round #3b82f6;
}

.muted {
    background: #1c2029;
    color: #94a3b8;
    height: 1;
    padding: 0 1;
}

/* ── screen roots ────────────────────────────────────────────────── */

#dashboard-root,
#worktrees-root,
#replay-root,
#sessions-root {
    height: 1fr;
    layout: vertical;
}

/* ── dashboard ───────────────────────────────────────────────────── */

#dashboard-status-bar {
    height: 1;
    background: #151921;
    padding: 0 2;
}

#dashboard-filter-row {
    height: 1;
    padding: 0 2;
}

#dashboard-main {
    height: 1fr;
}

#dashboard-agents {
    width: 35%;
}

#dashboard-sidebar {
    width: 65%;
    height: 1fr;
    layout: vertical;
}

#dashboard-detail {
    height: 1fr;
    min-height: 4;
}

#dashboard-log {
    height: auto;
    max-height: 8;
}

#dashboard-alerts {
    height: auto;
    max-height: 4;
}

/* ── worktrees ───────────────────────────────────────────────────── */

#worktrees-main {
    height: 1fr;
}

#worktrees-list {
    width: 35%;
}

#worktrees-sidebar {
    width: 65%;
    height: 1fr;
    layout: vertical;
}

#worktrees-detail {
    height: 1fr;
    min-height: 4;
}

#worktrees-conflicts {
    height: auto;
    max-height: 6;
}

#worktrees-intent {
    height: auto;
    max-height: 8;
}

/* ── replay ──────────────────────────────────────────────────────── */

#replay-summary {
    height: 1;
}

#replay-main {
    height: 1fr;
}

#replay-markers {
    width: 26%;
}

#replay-transcript {
    width: 74%;
}

#replay-detail {
    height: auto;
    max-height: 8;
}

/* ── inputs ──────────────────────────────────────────────────────── */

Input {
    background: transparent;
    color: #64748b;
    border: none;
    height: 1;
    padding: 0 0;
}

Input:focus {
    border: none;
    color: #e2e8f0;
}

#dashboard-filter-input {
    border: none;
    height: 1;
    padding: 0 0;
}

#dashboard-filter-input:focus {
    border: none;
    height: 1;
}

/* ── scrollbars ──────────────────────────────────────────────────── */

Static {
    scrollbar-background: #151921;
    scrollbar-color: #1c2029;
    scrollbar-color-hover: #272c36;
}

/* ── help ────────────────────────────────────────────────────────── */

#help-root {
    height: 1fr;
    border: round #272c36;
    border-title-color: #94a3b8;
    border-title-style: bold;
    padding: 1 2;
    background: #151921;
}

#help-root:focus-within {
    border: round #3b82f6;
}

/* ── list views (tight) ──────────────────────────────────────────── */

ListView {
    background: transparent;
    height: 1fr;
}

ListItem {
    background: transparent;
    padding: 0;
    height: 1;
}

ListView > ListItem.--highlight {
    background: #1e3a5f;
}

/* ── sessions ────────────────────────────────────────────────────── */

#sessions-summary {
    height: 1;
    margin-bottom: 0;
}

#sessions-filter-input {
    height: 3;
    margin-bottom: 0;
}

#sessions-main {
    height: 1fr;
}

#sessions-list {
    width: 2fr;
}

#sessions-detail {
    width: 1fr;
}
