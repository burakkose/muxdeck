Screen {
    background: rgb(7, 11, 17);
    color: rgb(222, 236, 248);
}

#shell-header {
    dock: top;
}

#shell-frame {
    height: 1fr;
    layout: vertical;
}

#screen-title {
    background: rgb(13, 21, 31);
    color: rgb(125, 211, 252);
    text-style: bold;
    padding: 0 2;
    height: 1;
}

#screen-body {
    height: 1fr;
    padding: 1 2;
    layout: vertical;
}

#shell-footer {
    dock: bottom;
    height: 1;
    background: rgb(13, 21, 31);
}

.band {
    margin-bottom: 1;
}

.panel {
    border: round rgb(37, 99, 235);
    background: rgb(13, 19, 28);
    padding: 0 1;
}

.muted-panel {
    border: round rgb(51, 65, 85);
    padding: 0 1;
    height: auto;
}

.panel-title {
    color: rgb(147, 197, 253);
    text-style: bold;
    margin-bottom: 1;
}

.tone-healthy {
    background: rgb(6, 78, 59);
    color: rgb(220, 252, 231);
    padding: 0 1;
}

.tone-warning {
    background: rgb(120, 53, 15);
    color: rgb(255, 237, 213);
    padding: 0 1;
}

.tone-critical {
    background: rgb(127, 29, 29);
    color: rgb(254, 226, 226);
    padding: 0 1;
}

#dashboard-root,
#worktrees-root,
#replay-root {
    height: 1fr;
    layout: vertical;
}

#dashboard-top,
#worktrees-summary,
#replay-summary {
    height: auto;
}

#dashboard-metrics,
#dashboard-filters,
#dashboard-filter-summary,
#worktrees-summary,
#replay-summary,
#help-content {
    color: rgb(191, 219, 254);
}

#dashboard-main,
#worktrees-main,
#replay-main {
    height: 1fr;
}

#dashboard-agents-panel,
#worktrees-list-panel,
#replay-markers-panel {
    width: 38%;
    margin-right: 1;
}

#dashboard-sidebar,
#worktrees-sidebar {
    width: 62%;
    height: 1fr;
    layout: vertical;
}

#dashboard-detail-panel,
#dashboard-log-panel,
#dashboard-alerts-panel,
#worktrees-detail-panel,
#worktrees-conflicts-panel,
#worktrees-intent-panel {
    height: 1fr;
    margin-bottom: 1;
}

#replay-transcript-panel {
    width: 62%;
}

#replay-detail-panel {
    height: 1fr;
}

Input {
    margin-top: 1;
    background: rgb(8, 15, 24);
    border: round rgb(51, 65, 85);
}

ListView {
    height: 1fr;
    background: transparent;
    border: none;
}

ListItem {
    color: rgb(226, 232, 240);
    padding: 0 1;
}

Static {
    scrollbar-background: rgb(13, 19, 28);
    scrollbar-color: rgb(51, 65, 85);
}

#help-root {
    height: 1fr;
    border: round rgb(51, 65, 85);
    padding: 1 2;
    background: rgb(13, 19, 28);
}
