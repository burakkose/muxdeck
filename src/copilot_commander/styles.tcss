Screen {
    background: rgb(16, 20, 27);
    color: rgb(219, 226, 239);
}

Header {
    dock: top;
    background: rgb(24, 30, 38);
    color: rgb(236, 239, 244);
}

#shell-frame {
    height: 1fr;
    layout: vertical;
    background: rgb(16, 20, 27);
}

#screen-title {
    background: rgb(28, 35, 44);
    color: rgb(167, 206, 255);
    text-style: bold;
    padding: 0 2;
    height: 1;
    margin: 0 1 1 1;
    border-left: wide rgb(126, 174, 255);
}

#screen-body {
    height: 1fr;
    padding: 0 1 1 1;
    layout: vertical;
}

#shell-footer {
    dock: bottom;
    height: 1;
    background: rgb(20, 26, 34);
}

.band {
    margin-bottom: 1;
}

.panel {
    border: round rgb(69, 90, 116);
    background: rgb(24, 30, 38);
    padding: 0 1;
}

.muted-panel {
    border: round rgb(55, 69, 88);
    background: rgb(21, 27, 35);
    padding: 0 1;
    height: auto;
}

.panel-title {
    color: rgb(176, 190, 215);
    text-style: bold;
    margin-bottom: 1;
}

.tone-healthy {
    background: rgb(27, 45, 39);
    color: rgb(212, 245, 222);
    padding: 0 1;
}

.tone-warning {
    background: rgb(56, 43, 27);
    color: rgb(255, 235, 196);
    padding: 0 1;
}

.tone-critical {
    background: rgb(59, 31, 34);
    color: rgb(255, 220, 220);
    padding: 0 1;
}

#dashboard-root,
#worktrees-root,
#replay-root {
    height: 1fr;
    layout: vertical;
}

#dashboard-top,
#worktrees-summary,
#replay-summary {
    height: auto;
}

#dashboard-metrics,
#dashboard-filters,
#dashboard-filter-summary,
#worktrees-summary,
#replay-summary,
#help-content {
    color: rgb(205, 216, 232);
}

#dashboard-main,
#worktrees-main,
#replay-main {
    height: 1fr;
}

#dashboard-agents-panel,
#worktrees-list-panel {
    width: 62%;
    margin-right: 1;
}

#dashboard-sidebar,
#worktrees-sidebar {
    width: 38%;
    height: 1fr;
    layout: vertical;
}

#dashboard-detail-panel,
#dashboard-log-panel,
#dashboard-alerts-panel,
#worktrees-detail-panel,
#worktrees-conflicts-panel,
#worktrees-intent-panel {
    height: 1fr;
    margin-bottom: 1;
}

#replay-markers-panel {
    width: 26%;
    margin-right: 1;
}

#replay-transcript-panel {
    width: 74%;
}

#replay-detail-panel {
    height: 1fr;
}

Input {
    margin-top: 1;
    background: rgb(18, 24, 31);
    color: rgb(236, 239, 244);
    border: round rgb(69, 90, 116);
}

Input:focus {
    border: round rgb(126, 174, 255);
}

Static {
    scrollbar-background: rgb(24, 30, 38);
    scrollbar-color: rgb(92, 120, 154);
}

#help-root {
    height: 1fr;
    border: round rgb(69, 90, 116);
    padding: 1 2;
    background: rgb(24, 30, 38);
}
