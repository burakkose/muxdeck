/* ── Gruvbox Dark — copilot-commander ─────────────────────────────── */

Screen {
    background: #282828;
    color: #ebdbb2;
}

/* ── shell chrome ────────────────────────────────────────────────── */

#shell-tab-bar {
    dock: top;
    height: 1;
    background: #1d2021;
    color: #ebdbb2;
}

#shell-frame {
    height: 1fr;
    layout: vertical;
    background: #282828;
    padding: 0 1;
}

#shell-footer {
    dock: bottom;
    height: 1;
    background: #1d2021;
}

/* ── shared frame: borderless content area ────────────────────────── */

.frame {
    border: none;
    background: #282828;
}

/* ── panel sections inside frames (borderless, thin separators) ─── */

.section {
    border: none;
    background: #282828;
    padding: 0 1;
}

.section-top {
    border: none;
    border-top: solid #504945;
    background: #282828;
    padding: 0 1;
}

.divider-right {
    border: none;
    border-right: solid #504945;
    padding: 0 1;
}

/* legacy .panel for screens not yet fully migrated */
.panel {
    border: none;
    background: #282828;
    padding: 0 1;
}

.muted {
    background: #3c3836;
    color: #bdae93;
    height: 1;
    padding: 0 1;
}

/* ── screen roots ────────────────────────────────────────────────── */

#dashboard-root,
#attention-root,
#operations-root,
#fleet-root,
#worktrees-root,
#replay-root,
#sessions-root,
#setup-root {
    height: 1fr;
    layout: vertical;
}

/* ── dashboard ───────────────────────────────────────────────────── */

#dashboard-status-bar {
    height: 2;
    background: #282828;
    padding: 0 1;
}

#dashboard-filter-row {
    height: 1;
    padding: 0 1;
}

#dashboard-main {
    height: 1fr;
}

#dashboard-agents {
    width: 38%;
    min-width: 34;
    border-right: solid #504945;
}

#dashboard-sidebar {
    width: 62%;
    height: 1fr;
    layout: vertical;
}

#dashboard-detail {
    height: auto;
    min-height: 6;
    max-height: 10;
}

#dashboard-log {
    height: 1fr;
    min-height: 10;
    border-top: solid #504945;
    padding-top: 0;
}

#dashboard-alerts {
    height: auto;
    max-height: 6;
    border-top: solid #504945;
    padding-top: 0;
}

/* ── attention ───────────────────────────────────────────────────── */

#attention-main {
    height: 1fr;
}

#attention-list {
    width: 38%;
}

#attention-sidebar {
    width: 62%;
    height: 1fr;
    layout: vertical;
}

#attention-detail {
    min-height: 9;
}

#attention-log {
    height: 1fr;
    min-height: 8;
}

#attention-activity {
    height: auto;
    min-height: 6;
}

/* ── operations ─────────────────────────────────────────────────── */

#operations-main {
    height: 1fr;
}

#operations-agents {
    width: 38%;
}

#operations-sidebar {
    width: 62%;
    height: 1fr;
    layout: vertical;
}

#operations-top {
    height: auto;
    min-height: 12;
    max-height: 16;
}

#operations-bottom {
    height: 1fr;
    border-top: solid #504945;
}

#operations-selection {
    width: 62%;
}

#operations-health {
    width: 38%;
    min-width: 24;
}

#operations-preview {
    width: 68%;
    height: 1fr;
}

#operations-sidepanels {
    width: 32%;
    height: 1fr;
    layout: vertical;
}

#operations-alerts {
    height: auto;
    max-height: 8;
}

#operations-history {
    height: 1fr;
}

/* ── fleet ──────────────────────────────────────────────────────── */

#fleet-summary {
    height: 1;
}

#fleet-filter-input {
    border: none;
    height: 1;
    padding: 0 0;
}

#fleet-main {
    height: 1fr;
}

#fleet-groups {
    width: 52%;
}

#fleet-side {
    width: 48%;
    height: 1fr;
    layout: vertical;
}

#fleet-resources {
    height: auto;
    min-height: 8;
}

#fleet-history {
    height: auto;
    min-height: 10;
}

#fleet-search {
    height: 1fr;
}

/* ── worktrees ───────────────────────────────────────────────────── */

#worktrees-main {
    height: 1fr;
}

#worktrees-list {
    width: 45%;
    min-width: 30;
}

#worktrees-sidebar {
    width: 55%;
    height: 1fr;
    layout: vertical;
}

#worktrees-detail {
    height: 1fr;
    min-height: 8;
}

#worktrees-conflicts {
    height: auto;
    max-height: 6;
    border-top: solid #504945;
}

#worktrees-intent {
    height: auto;
    max-height: 10;
    border-top: solid #504945;
}

/* ── replay ──────────────────────────────────────────────────────── */

#replay-summary {
    height: 1;
}

#replay-actions {
    height: 2;
}

#replay-main {
    height: 1fr;
}

#replay-markers {
    width: 26%;
}

#replay-transcript {
    width: 74%;
}

#replay-detail {
    height: auto;
    max-height: 10;
}

/* ── inputs ──────────────────────────────────────────────────────── */

Input {
    background: transparent;
    color: #a89984;
    border: none;
    height: 1;
    padding: 0 0;
}

Input:focus {
    border: none;
    color: #ebdbb2;
}

#dashboard-filter-input {
    border: none;
    height: 1;
    padding: 0 0;
}

#dashboard-filter-input:focus {
    border: none;
    height: 1;
}

/* ── scrollbars (subtle Gruvbox) ──────────────────────────────────── */

Static {
    scrollbar-background: #282828;
    scrollbar-color: #3c3836;
    scrollbar-color-hover: #504945;
    scrollbar-size: 1 1;
}

ListView {
    scrollbar-background: #282828;
    scrollbar-color: #3c3836;
    scrollbar-color-hover: #504945;
    scrollbar-size: 1 1;
}

/* ── help ────────────────────────────────────────────────────────── */

#help-root {
    height: 1fr;
    border: none;
    padding: 1 2;
    background: #282828;
    scrollbar-background: #282828;
    scrollbar-color: #3c3836;
    scrollbar-color-hover: #504945;
    scrollbar-size: 1 1;
}

#help-root:focus-within {
    border: none;
}

/* ── list views (tight) ──────────────────────────────────────────── */

ListView {
    background: transparent;
    height: 1fr;
}

ListItem {
    background: transparent;
    padding: 0;
    height: 1;
}

ListView > ListItem.--highlight {
    background: #3c3836;
}

/* ── sessions ────────────────────────────────────────────────────── */

#sessions-summary {
    height: 1;
    margin-bottom: 0;
}

#sessions-actions {
    height: 2;
}

/* ── setup ───────────────────────────────────────────────────────── */

#setup-main {
    height: 1fr;
}

#setup-sockets {
    width: 38%;
}

#setup-sidebar {
    width: 62%;
    height: 1fr;
    layout: vertical;
}

#setup-summary {
    height: auto;
    min-height: 5;
}

#setup-checks {
    height: 1fr;
}

#sessions-filter-input {
    height: 1;
    margin-bottom: 0;
}

#sessions-main {
    height: 1fr;
}

#sessions-list {
    width: 2fr;
}

#sessions-detail {
    width: 1fr;
}
