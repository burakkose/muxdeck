/* ── Gruvbox Dark — copilot-commander ─────────────────────────────── */

Screen {
    background: #282828;
    color: #ebdbb2;
}

/* ── shell chrome ────────────────────────────────────────────────── */

#shell-tab-bar {
    dock: top;
    height: 1;
    background: #1d2021;
    color: #ebdbb2;
}

#shell-frame {
    height: 1fr;
    layout: vertical;
    background: #282828;
    padding: 0 0;
}

#shell-footer {
    dock: bottom;
    height: 1;
    background: #1d2021;
}

/* ── panels: border-title pattern ────────────────────────────────── */

.panel {
    border: solid #504945;
    background: #3c3836;
    padding: 0 1;
    border-title-color: #bdae93;
    border-title-style: bold;
}

.panel:focus-within {
    border: solid #83a598;
}

.muted {
    background: #32302f;
    color: #d5c4a1;
    height: 1;
    padding: 0 1;
}

/* ── screen roots ────────────────────────────────────────────────── */

#dashboard-root,
#worktrees-root,
#replay-root {
    height: 1fr;
    layout: vertical;
}

/* ── dashboard ───────────────────────────────────────────────────── */

#dashboard-status-bar {
    height: 1;
    background: #32302f;
    padding: 0 1;
}

#dashboard-filter-row {
    height: 1;
}

#dashboard-main {
    height: 1fr;
}

#dashboard-agents {
    width: 35%;
}

#dashboard-sidebar {
    width: 65%;
    height: 1fr;
    layout: vertical;
}

#dashboard-detail {
    height: 1fr;
    min-height: 6;
}

#dashboard-log {
    height: auto;
    max-height: 8;
}

#dashboard-alerts {
    height: auto;
    max-height: 6;
}

/* ── worktrees ───────────────────────────────────────────────────── */

#worktrees-main {
    height: 1fr;
}

#worktrees-list {
    width: 35%;
}

#worktrees-sidebar {
    width: 65%;
    height: 1fr;
    layout: vertical;
}

#worktrees-detail {
    height: 1fr;
    min-height: 6;
}

#worktrees-conflicts {
    height: auto;
    max-height: 6;
}

#worktrees-intent {
    height: auto;
    max-height: 10;
}

/* ── replay ──────────────────────────────────────────────────────── */

#replay-summary {
    height: 1;
}

#replay-main {
    height: 1fr;
}

#replay-markers {
    width: 26%;
}

#replay-transcript {
    width: 74%;
}

#replay-detail {
    height: auto;
    max-height: 8;
}

/* ── inputs ──────────────────────────────────────────────────────── */

Input {
    background: #1d2021;
    color: #ebdbb2;
    border: none;
    height: 1;
    padding: 0 0;
}

Input:focus {
    border: none;
}

#dashboard-filter-input {
    border: none;
    height: 1;
    padding: 0 0;
}

#dashboard-filter-input:focus {
    border: none;
    height: 1;
}

/* ── scrollbars ──────────────────────────────────────────────────── */

Static {
    scrollbar-background: #3c3836;
    scrollbar-color: #504945;
    scrollbar-color-hover: #665c54;
}

/* ── help ────────────────────────────────────────────────────────── */

#help-root {
    height: 1fr;
    border: solid #504945;
    border-title-color: #bdae93;
    border-title-style: bold;
    padding: 0 1;
    background: #3c3836;
}

#help-root:focus-within {
    border: solid #83a598;
}

/* ── list views (tight) ──────────────────────────────────────────── */

ListView {
    background: transparent;
    height: 1fr;
}

ListItem {
    background: transparent;
    padding: 0;
    height: 1;
}

ListView > ListItem.--highlight {
    background: #504945;
}
