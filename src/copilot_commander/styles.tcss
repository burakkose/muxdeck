/* ── Gruvbox Dark — copilot-commander ─────────────────────────────── */

Screen {
    background: #282828;
    color: #ebdbb2;
}

Header {
    dock: top;
    background: #1d2021;
    color: #ebdbb2;
}

#shell-frame {
    height: 1fr;
    layout: vertical;
    background: #282828;
}

#screen-title {
    background: #3c3836;
    color: #83a598;
    text-style: bold;
    padding: 0 2;
    height: 1;
    margin: 0 1 1 1;
    border-left: wide #83a598;
}

#screen-body {
    height: 1fr;
    padding: 0 1 1 1;
    layout: vertical;
}

#shell-footer {
    dock: bottom;
    height: 1;
    background: #1d2021;
}

.band {
    margin-bottom: 1;
}

.panel {
    border: round #665c54;
    background: #3c3836;
    padding: 0 1;
}

.muted-panel {
    border: round #504945;
    background: #32302f;
    padding: 0 1;
    height: auto;
}

.panel-title {
    color: #bdae93;
    text-style: bold;
    margin-bottom: 1;
}

.tone-healthy {
    background: #2b3328;
    color: #b8bb26;
    padding: 0 1;
}

.tone-warning {
    background: #3c3020;
    color: #fabd2f;
    padding: 0 1;
}

.tone-critical {
    background: #3c2020;
    color: #fb4934;
    padding: 0 1;
}

#dashboard-root,
#worktrees-root,
#replay-root {
    height: 1fr;
    layout: vertical;
}

#dashboard-top,
#worktrees-summary,
#replay-summary {
    height: auto;
}

#dashboard-metrics,
#dashboard-filters,
#dashboard-filter-summary,
#worktrees-summary,
#replay-summary,
#help-content {
    color: #d5c4a1;
}

#dashboard-filters {
    height: auto;
}

#dashboard-main,
#worktrees-main,
#replay-main {
    height: 1fr;
}

#dashboard-agents-panel,
#worktrees-list-panel {
    width: 62%;
    margin-right: 1;
}

#dashboard-sidebar,
#worktrees-sidebar {
    width: 38%;
    height: 1fr;
    layout: vertical;
}

#dashboard-detail-panel,
#dashboard-log-panel,
#dashboard-alerts-panel,
#worktrees-detail-panel,
#worktrees-conflicts-panel,
#worktrees-intent-panel {
    height: 1fr;
    margin-bottom: 1;
}

#replay-markers-panel {
    width: 26%;
    margin-right: 1;
}

#replay-transcript-panel {
    width: 74%;
}

#replay-detail-panel {
    height: 1fr;
}

Input {
    margin-top: 1;
    background: #1d2021;
    color: #ebdbb2;
    border: round #665c54;
}

Input:focus {
    border: round #83a598;
}

Static {
    scrollbar-background: #3c3836;
    scrollbar-color: #665c54;
}

#help-root {
    height: 1fr;
    border: round #665c54;
    padding: 1 2;
    background: #3c3836;
}
