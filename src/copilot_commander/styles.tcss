/* ── Gruvbox Dark — copilot-commander ─────────────────────────────── */

Screen {
    background: #282828;
    color: #ebdbb2;
}

/* ── shell chrome ────────────────────────────────────────────────── */

#shell-tab-bar {
    dock: top;
    height: 1;
    background: #1d2021;
    color: #ebdbb2;
}

#shell-frame {
    height: 1fr;
    layout: vertical;
    background: #282828;
    padding: 0 1;
}

#shell-footer {
    dock: bottom;
    height: 1;
    background: #1d2021;
}

/* ── panels: border-title pattern ────────────────────────────────── */

.panel {
    border: solid #504945;
    background: #3c3836;
    padding: 0 1;
    border-title-color: #bdae93;
    border-title-style: bold;
}

.panel:focus-within {
    border: solid #83a598;
}

.muted {
    background: #32302f;
    color: #d5c4a1;
    height: auto;
    padding: 0 1;
}

/* ── health tones (applied to status bar) ────────────────────────── */

.tone-healthy {
    background: #2b3328;
    color: #b8bb26;
}

.tone-warning {
    background: #3c3020;
    color: #fabd2f;
}

.tone-critical {
    background: #3c2020;
    color: #fb4934;
}

/* ── screen roots ────────────────────────────────────────────────── */

#dashboard-root,
#worktrees-root,
#replay-root,
#sessions-root {
    height: 1fr;
    layout: vertical;
}

/* ── dashboard ───────────────────────────────────────────────────── */

#dashboard-status-bar {
    height: 1;
    margin-bottom: 0;
}

#dashboard-filter-row {
    height: 3;
    margin-bottom: 0;
}

#dashboard-main {
    height: 1fr;
}

#dashboard-agents {
    width: 60%;
    margin-right: 1;
}

#dashboard-sidebar {
    width: 40%;
    height: 1fr;
    layout: vertical;
}

#dashboard-detail {
    height: 2fr;
    margin-bottom: 0;
}

#dashboard-log {
    height: 1fr;
    margin-bottom: 0;
}

#dashboard-alerts {
    height: 1fr;
}

/* ── worktrees ───────────────────────────────────────────────────── */

#worktrees-summary {
    height: auto;
}

#worktrees-main {
    height: 1fr;
}

#worktrees-list {
    width: 60%;
    margin-right: 1;
}

#worktrees-sidebar {
    width: 40%;
    height: 1fr;
    layout: vertical;
}

#worktrees-detail {
    height: 1fr;
    margin-bottom: 0;
}

#worktrees-conflicts {
    height: 1fr;
    margin-bottom: 0;
}

#worktrees-intent {
    height: 1fr;
}

/* ── replay ──────────────────────────────────────────────────────── */

#replay-summary {
    height: auto;
}

#replay-main {
    height: 1fr;
}

#replay-markers {
    width: 26%;
    margin-right: 1;
}

#replay-transcript {
    width: 74%;
}

#replay-detail {
    height: 1fr;
}

/* ── inputs ──────────────────────────────────────────────────────── */

Input {
    background: #1d2021;
    color: #ebdbb2;
    border: solid #504945;
    height: 3;
}

Input:focus {
    border: solid #83a598;
}

/* ── scrollbars ──────────────────────────────────────────────────── */

Static {
    scrollbar-background: #3c3836;
    scrollbar-color: #504945;
    scrollbar-color-hover: #665c54;
}

/* ── help ────────────────────────────────────────────────────────── */

#help-root {
    height: 1fr;
    border: solid #504945;
    border-title-color: #bdae93;
    border-title-style: bold;
    padding: 1 2;
    background: #3c3836;
}

#help-root:focus-within {
    border: solid #83a598;
}

/* ── list views (tight) ──────────────────────────────────────────── */

ListView {
    background: transparent;
    height: 1fr;
}

ListItem {
    background: transparent;
    padding: 0;
    height: 1;
}

ListView > ListItem.--highlight {
    background: #504945;
}

/* ── sessions ────────────────────────────────────────────────────── */

#sessions-summary {
    height: 1;
    margin-bottom: 0;
}

#sessions-main {
    height: 1fr;
}

#sessions-list {
    width: 2fr;
}

#sessions-detail {
    width: 1fr;
}
