/* ── Muxdeck — graphite theme ─────────────────────────────
 *
 * Calm dark-mode palette. Hex values mirror src/muxdeck/theme.py so
 * widgets and CSS reference the same source of truth. Borders are
 * deliberately faint — panels read as separated by whitespace, not
 * by visible rules. Selection uses a raised graphite surface, not a
 * loud accent colour. */

Screen {
    background: #0B0D10;
    color: #F2F4F8;
}

.ux-contrast-high Screen {
    background: #0B0D10;
}

/* ── shell chrome ────────────────────────────────────────────────── */

#shell-tab-bar {
    dock: top;
    height: 1;
    background: #0B0D10;
    color: #6F7887;
}

#shell-frame {
    height: 1fr;
    layout: vertical;
    background: #0B0D10;
    padding: 0 1;
}

#shell-footer {
    dock: bottom;
    height: 1;
    background: #0B0D10;
}

/* ── shared frame: borderless content area ────────────────────────── */

.frame {
    border: none;
    background: #0B0D10;
}

/* ── panel sections inside frames (borderless, thin separators) ─── */

.section {
    border: none;
    background: #12151B;
    padding: 0 1;
}

.section-top {
    border: none;
    border-top: solid #191D25;
    background: #12151B;
    padding: 0 1;
}

.divider-right {
    border: none;
    border-right: solid #191D25;
    padding: 0 1;
}

/* legacy .panel for screens not yet fully migrated */
.panel {
    border: none;
    background: #12151B;
    padding: 0 1;
}

.muted {
    background: #0B0D10;
    color: #6F7887;
    height: 1;
    padding: 0 1;
}

.focusable {
    border-left: solid transparent;
    padding-left: 1;
}

.focusable:focus {
    background: #191D25;
    border-left: solid #5AC8FA;
}

/* ── screen roots ────────────────────────────────────────────────── */

#dashboard-root,
#attention-root,
#worktrees-root,
#replay-root,
#sessions-root,
#setup-root {
    height: 1fr;
    layout: vertical;
}

/* ── dashboard ───────────────────────────────────────────────────── */

#dashboard-status-bar {
    height: 2;
    background: #0B0D10;
    padding: 0 1;
}

#dashboard-filter-row {
    height: 2;
    padding: 0 1;
}

#dashboard-main {
    height: 1fr;
}

#dashboard-agents {
    width: 38%;
    min-width: 34;
    border-right: solid #191D25;
}

#dashboard-sidebar {
    width: 62%;
    height: 1fr;
    layout: vertical;
}

#dashboard-detail {
    height: auto;
    min-height: 6;
    max-height: 12;
}

#dashboard-log {
    height: 1fr;
    min-height: 8;
    max-height: 18;
    border-top: solid #191D25;
    padding-top: 0;
}

#dashboard-alerts {
    height: auto;
    max-height: 6;
    border-top: solid #191D25;
    padding-top: 0;
}

/* When the dashboard has no attention items, collapse the panel
 * completely instead of showing an empty section. The output panel
 * below it claims the released vertical space. */
#dashboard-alerts.empty {
    display: none;
    height: 0;
    border-top: none;
}

/* ── attention ───────────────────────────────────────────────────── */

#attention-main {
    height: 1fr;
}

#attention-list {
    width: 38%;
}

#attention-sidebar {
    width: 62%;
    height: 1fr;
    layout: vertical;
}

#attention-detail {
    min-height: 9;
}

#attention-log {
    height: 1fr;
    min-height: 8;
}

#attention-activity {
    height: auto;
    min-height: 6;
}

/* ── worktrees ───────────────────────────────────────────────────── */

#worktrees-main {
    height: 1fr;
}

#worktrees-list {
    width: 45%;
    min-width: 30;
}

#worktrees-sidebar {
    width: 55%;
    height: 1fr;
    layout: vertical;
}

#worktrees-detail {
    height: 1fr;
    min-height: 8;
}

#worktrees-conflicts {
    height: auto;
    max-height: 6;
    border-top: solid #191D25;
}

#worktrees-intent {
    height: auto;
    max-height: 12;
    border-top: solid #191D25;
}

/* ── replay ──────────────────────────────────────────────────────── */

#replay-summary {
    height: 1;
}

#replay-filter-row {
    height: 2;
}

#replay-actions {
    height: 2;
}

#replay-main {
    height: 1fr;
}

#replay-markers {
    width: 26%;
}

#replay-transcript {
    width: 74%;
}

#replay-detail {
    height: auto;
    max-height: 10;
}

/* ── inputs ──────────────────────────────────────────────────────── */

Input {
    background: #12151B;
    color: #A7AFBD;
    border: none;
    height: 1;
    border-bottom: solid transparent;
    padding: 0 1;
}

Input:focus {
    background: #191D25;
    border-bottom: solid #5AC8FA;
    color: #F2F4F8;
}

.ux-contrast-high Input {
    background: #12151B;
    color: #D6DAE2;
}

.ux-contrast-high Input:focus {
    background: #233044;
    border-bottom: solid #5AC8FA;
    color: #F2F4F8;
}

#dashboard-filter-input {
    border: none;
    height: 1;
    padding: 0 1;
}

#dashboard-filter-input:focus {
    border: none;
    height: 1;
}

.filter-summary {
    height: 1;
    color: #6F7887;
    padding: 0 1;
}

/* ── scrollbars (subtle graphite) ─────────────────────────────────── */

Static {
    scrollbar-background: #0B0D10;
    scrollbar-color: #191D25;
    scrollbar-color-hover: #233044;
    scrollbar-size: 1 1;
}

ListView {
    scrollbar-background: #0B0D10;
    scrollbar-color: #191D25;
    scrollbar-color-hover: #233044;
    scrollbar-size: 1 1;
}

/* ── help ────────────────────────────────────────────────────────── */

#help-root {
    height: 1fr;
    layout: vertical;
    background: #0B0D10;
}

#help-filter-input {
    margin: 0 1;
}

#help-scroll {
    height: 1fr;
    border: none;
    padding: 1 2;
    background: #0B0D10;
    scrollbar-background: #0B0D10;
    scrollbar-color: #191D25;
    scrollbar-color-hover: #233044;
    scrollbar-size: 1 1;
}

#help-scroll:focus-within {
    border: none;
}

/* ── list views (tight) ──────────────────────────────────────────── */

ListView {
    background: transparent;
    height: 1fr;
    border-left: solid transparent;
}

ListItem {
    background: transparent;
    padding: 0;
    height: 1;
}

ListView > ListItem.--highlight {
    background: #233044;
}

ListView:focus {
    background: #191D25;
    border-left: solid #5AC8FA;
}

/* ── sessions ────────────────────────────────────────────────────── */

#sessions-summary {
    height: 1;
    margin-bottom: 0;
}

#sessions-actions {
    height: 2;
}

/* ── setup ───────────────────────────────────────────────────────── */

#setup-main {
    height: 1fr;
}

#setup-sockets {
    width: 38%;
}

#setup-sidebar {
    width: 62%;
    height: 1fr;
    layout: vertical;
}

#setup-summary {
    height: auto;
    min-height: 5;
}

#setup-checks {
    height: 1fr;
}

#sessions-filter-input {
    height: 1;
    margin-bottom: 0;
}

#sessions-main {
    height: 1fr;
}

#sessions-list {
    width: 2fr;
}

#sessions-detail {
    width: 1fr;
}

.ux-density-comfortable #dashboard-agents {
    width: 44%;
    min-width: 40;
}

.ux-density-comfortable #dashboard-sidebar {
    width: 56%;
}

.ux-density-comfortable #replay-markers {
    width: 30%;
}

.ux-density-comfortable #replay-transcript {
    width: 70%;
}

.ux-density-comfortable #sessions-list {
    width: 2.2fr;
}

.ux-density-comfortable ListItem {
    height: auto;
    padding: 0 0 1 0;
}

.ux-contrast-high #shell-tab-bar,
.ux-contrast-high #shell-footer,
.ux-contrast-high .frame,
.ux-contrast-high .section,
.ux-contrast-high .panel,
.ux-contrast-high .muted,
.ux-contrast-high #help-scroll {
    background: #0B0D10;
}

.ux-contrast-high .divider-right {
    border-right: solid #2C3A52;
}

.ux-contrast-high .section-top,
.ux-contrast-high #dashboard-log,
.ux-contrast-high #dashboard-alerts,
.ux-contrast-high #worktrees-conflicts,
.ux-contrast-high #worktrees-intent {
    border-top: solid #2C3A52;
}

.ux-contrast-high .focusable:focus,
.ux-contrast-high ListView:focus {
    background: #233044;
    border-left: solid #5AC8FA;
}

.ux-decor-reduced .divider-right {
    border-right: solid #12151B;
}

.ux-decor-reduced .section-top,
.ux-decor-reduced #dashboard-log,
.ux-decor-reduced #dashboard-alerts,
.ux-decor-reduced #worktrees-conflicts,
.ux-decor-reduced #worktrees-intent {
    border-top: solid #12151B;
}
