/* ── Ayu Mirage — muxdeck ───────────────────────────────── */

Screen {
    background: #1F2430;
    color: #CCCAC2;
}

.ux-contrast-high Screen {
    background: #181C26;
}

/* ── shell chrome ────────────────────────────────────────────────── */

#shell-tab-bar {
    dock: top;
    height: 1;
    background: #181C26;
    color: #C7C7C7;
}

#shell-frame {
    height: 1fr;
    layout: vertical;
    background: #1F2430;
    padding: 0 1;
}

#shell-footer {
    dock: bottom;
    height: 1;
    background: #181C26;
}

/* ── shared frame: borderless content area ────────────────────────── */

.frame {
    border: none;
    background: #1F2430;
}

/* ── panel sections inside frames (borderless, thin separators) ─── */

.section {
    border: none;
    background: #1F2430;
    padding: 0 1;
}

.section-top {
    border: none;
    border-top: solid #171B24;
    background: #1F2430;
    padding: 0 1;
}

.divider-right {
    border: none;
    border-right: solid #171B24;
    padding: 0 1;
}

/* legacy .panel for screens not yet fully migrated */
.panel {
    border: none;
    background: #1F2430;
    padding: 0 1;
}

.muted {
    background: #242936;
    color: #8A9199;
    height: 1;
    padding: 0 1;
}

.focusable {
    border-left: solid transparent;
    padding-left: 1;
}

.focusable:focus {
    background: #242936;
    border-left: solid #73D0FF;
}

/* ── screen roots ────────────────────────────────────────────────── */

#dashboard-root,
#attention-root,
#operations-root,
#fleet-root,
#worktrees-root,
#replay-root,
#sessions-root,
#setup-root {
    height: 1fr;
    layout: vertical;
}

/* ── dashboard ───────────────────────────────────────────────────── */

#dashboard-status-bar {
    height: 2;
    background: #1F2430;
    padding: 0 1;
}

#dashboard-filter-row {
    height: 2;
    padding: 0 1;
}

#dashboard-main {
    height: 1fr;
}

#dashboard-agents {
    width: 38%;
    min-width: 34;
    border-right: solid #171B24;
}

#dashboard-sidebar {
    width: 62%;
    height: 1fr;
    layout: vertical;
}

#dashboard-detail {
    height: auto;
    min-height: 6;
    max-height: 10;
}

#dashboard-log {
    height: 1fr;
    min-height: 10;
    border-top: solid #171B24;
    padding-top: 0;
}

#dashboard-alerts {
    height: auto;
    max-height: 6;
    border-top: solid #171B24;
    padding-top: 0;
}

/* ── attention ───────────────────────────────────────────────────── */

#attention-main {
    height: 1fr;
}

#attention-list {
    width: 38%;
}

#attention-sidebar {
    width: 62%;
    height: 1fr;
    layout: vertical;
}

#attention-detail {
    min-height: 9;
}

#attention-log {
    height: 1fr;
    min-height: 8;
}

#attention-activity {
    height: auto;
    min-height: 6;
}

/* ── operations ─────────────────────────────────────────────────── */

#operations-main {
    height: 1fr;
}

#operations-agents {
    width: 38%;
}

#operations-sidebar {
    width: 62%;
    height: 1fr;
    layout: vertical;
}

#operations-top {
    height: auto;
    min-height: 12;
    max-height: 16;
}

#operations-bottom {
    height: 1fr;
    border-top: solid #171B24;
}

#operations-selection {
    width: 62%;
}

#operations-health {
    width: 38%;
    min-width: 24;
}

#operations-preview {
    width: 68%;
    height: 1fr;
}

#operations-sidepanels {
    width: 32%;
    height: 1fr;
    layout: vertical;
}

#operations-alerts {
    height: auto;
    max-height: 8;
}

#operations-history {
    height: 1fr;
}

/* ── fleet ──────────────────────────────────────────────────────── */

#fleet-summary {
    height: 1;
    padding: 0 1;
}

#fleet-filter-input {
    border: none;
    height: 1;
    background: #181C26;
    color: #CCCAC2;
    padding: 0 1;
    margin: 0 1;
}

#fleet-main {
    height: 1fr;
}

#fleet-stories {
    width: 37%;
    min-width: 32;
}

#fleet-side {
    width: 63%;
    height: 1fr;
    layout: vertical;
}

#fleet-command {
    height: auto;
    min-height: 14;
    max-height: 18;
}

#fleet-middle {
    height: auto;
    min-height: 11;
    max-height: 15;
    border-top: solid #171B24;
}

#fleet-sessions {
    width: 62%;
}

#fleet-inbox {
    width: 38%;
    min-width: 26;
}

#fleet-bottom {
    height: 1fr;
    border-top: solid #171B24;
}

#fleet-history {
    width: 58%;
    height: 1fr;
}

#fleet-search {
    width: 42%;
    height: 1fr;
}

/* ── worktrees ───────────────────────────────────────────────────── */

#worktrees-main {
    height: 1fr;
}

#worktrees-list {
    width: 45%;
    min-width: 30;
}

#worktrees-sidebar {
    width: 55%;
    height: 1fr;
    layout: vertical;
}

#worktrees-detail {
    height: 1fr;
    min-height: 8;
}

#worktrees-conflicts {
    height: auto;
    max-height: 6;
    border-top: solid #171B24;
}

#worktrees-intent {
    height: auto;
    max-height: 10;
    border-top: solid #171B24;
}

/* ── replay ──────────────────────────────────────────────────────── */

#replay-summary {
    height: 1;
}

#replay-filter-row {
    height: 2;
}

#replay-actions {
    height: 2;
}

#replay-main {
    height: 1fr;
}

#replay-markers {
    width: 26%;
}

#replay-transcript {
    width: 74%;
}

#replay-detail {
    height: auto;
    max-height: 10;
}

/* ── inputs ──────────────────────────────────────────────────────── */

Input {
    background: #181C26;
    color: #8A9199;
    border: none;
    height: 1;
    border-bottom: solid transparent;
    padding: 0 1;
}

Input:focus {
    background: #242936;
    border-bottom: solid #73D0FF;
    color: #CCCAC2;
}

.ux-contrast-high Input {
    background: #181C26;
    color: #C7C7C7;
}

.ux-contrast-high Input:focus {
    background: #2F3744;
    border-bottom: solid #FFCD66;
    color: #CCCAC2;
}

#dashboard-filter-input {
    border: none;
    height: 1;
    padding: 0 1;
}

#dashboard-filter-input:focus {
    border: none;
    height: 1;
}

.filter-summary {
    height: 1;
    color: #5C6773;
    padding: 0 1;
}

/* ── scrollbars (subtle Ayu) ──────────────────────────────────────── */

Static {
    scrollbar-background: #1F2430;
    scrollbar-color: #2F3744;
    scrollbar-color-hover: #48515F;
    scrollbar-size: 1 1;
}

ListView {
    scrollbar-background: #1F2430;
    scrollbar-color: #2F3744;
    scrollbar-color-hover: #48515F;
    scrollbar-size: 1 1;
}

/* ── help ────────────────────────────────────────────────────────── */

#help-root {
    height: 1fr;
    layout: vertical;
    background: #1F2430;
}

#help-filter-input {
    margin: 0 1;
}

#help-scroll {
    height: 1fr;
    border: none;
    padding: 1 2;
    background: #1F2430;
    scrollbar-background: #1F2430;
    scrollbar-color: #2F3744;
    scrollbar-color-hover: #48515F;
    scrollbar-size: 1 1;
}

#help-scroll:focus-within {
    border: none;
}

/* ── list views (tight) ──────────────────────────────────────────── */

ListView {
    background: transparent;
    height: 1fr;
    border-left: solid transparent;
}

ListItem {
    background: transparent;
    padding: 0;
    height: 1;
}

ListView > ListItem.--highlight {
    background: #2F3744;
}

ListView:focus {
    background: #242936;
    border-left: solid #73D0FF;
}

/* ── sessions ────────────────────────────────────────────────────── */

#sessions-summary {
    height: 1;
    margin-bottom: 0;
}

#sessions-actions {
    height: 2;
}

/* ── setup ───────────────────────────────────────────────────────── */

#setup-main {
    height: 1fr;
}

#setup-sockets {
    width: 38%;
}

#setup-sidebar {
    width: 62%;
    height: 1fr;
    layout: vertical;
}

#setup-summary {
    height: auto;
    min-height: 5;
}

#setup-checks {
    height: 1fr;
}

#sessions-filter-input {
    height: 1;
    margin-bottom: 0;
}

#sessions-main {
    height: 1fr;
}

#sessions-list {
    width: 2fr;
}

#sessions-detail {
    width: 1fr;
}

.ux-density-comfortable #dashboard-agents {
    width: 44%;
    min-width: 40;
}

.ux-density-comfortable #dashboard-sidebar {
    width: 56%;
}

.ux-density-comfortable #fleet-groups,
.ux-density-comfortable #fleet-stories {
    width: 42%;
    min-width: 36;
}

.ux-density-comfortable #fleet-side {
    width: 58%;
}

.ux-density-comfortable #operations-agents {
    width: 42%;
}

.ux-density-comfortable #operations-sidebar {
    width: 58%;
}

.ux-density-comfortable #replay-markers {
    width: 30%;
}

.ux-density-comfortable #replay-transcript {
    width: 70%;
}

.ux-density-comfortable #sessions-list {
    width: 2.2fr;
}

.ux-density-comfortable ListItem {
    height: auto;
    padding: 0 0 1 0;
}

.ux-contrast-high #shell-tab-bar,
.ux-contrast-high #shell-footer,
.ux-contrast-high .frame,
.ux-contrast-high .section,
.ux-contrast-high .panel,
.ux-contrast-high .muted,
.ux-contrast-high #help-scroll {
    background: #181C26;
}

.ux-contrast-high .divider-right {
    border-right: solid #48515F;
}

.ux-contrast-high .section-top,
.ux-contrast-high #dashboard-log,
.ux-contrast-high #dashboard-alerts,
.ux-contrast-high #fleet-middle,
.ux-contrast-high #fleet-bottom,
.ux-contrast-high #operations-bottom,
.ux-contrast-high #worktrees-conflicts,
.ux-contrast-high #worktrees-intent {
    border-top: solid #48515F;
}

.ux-contrast-high .focusable:focus,
.ux-contrast-high ListView:focus {
    background: #2F3744;
    border-left: solid #FFCD66;
}

.ux-decor-reduced .divider-right {
    border-right: solid #242936;
}

.ux-decor-reduced .section-top,
.ux-decor-reduced #dashboard-log,
.ux-decor-reduced #dashboard-alerts,
.ux-decor-reduced #fleet-middle,
.ux-decor-reduced #fleet-bottom,
.ux-decor-reduced #operations-bottom,
.ux-decor-reduced #worktrees-conflicts,
.ux-decor-reduced #worktrees-intent {
    border-top: solid #242936;
}
